# Flask Configuration
FLASK_APP=app3.py
FLASK_ENV=production
SECRET_KEY=your-secret-key-here

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/your_database_name

# Redis Configuration (for session management and caching)
REDIS_URL=rediss://red-xxxxx:port
REDIS_PASSWORD=your-redis-password

# Application Settings
LICENSE_DURATION=240  # in minutes
LICENSE_CHECK_INTERVAL=60  # in minutes

# NSE API Configuration (if used)
NSE_API_KEY=your-nse-api-key

# Email Configuration (if used)
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-email-password
MAIL_DEFAULT_SENDER=your-email@example.com

# File Upload Configuration
UPLOAD_FOLDER=static/uploads
MAX_CONTENT_LENGTH=16 * 1024 * 1024  # 16MB max file size
ALLOWED_EXTENSIONS={'png', 'jpg', 'jpeg', 'gif'}

# Other Settings
DEBUG=False
TESTING=False
