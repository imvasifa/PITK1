//@version=5
strategy("RA NEW", overlay=true) //RAHIM 2.0 HEIKENASHI VWAP BUY

// Custom Colors
hot_pink = color.rgb(255, 105, 180, 0)
cyan = color.rgb(0, 255, 255, 0)
gold = color.rgb(255, 215, 0, 0)
violet = color.rgb(138, 43, 226, 0)
sky_blue = color.rgb(135, 206, 235, 0)
coral = color.rgb(255, 127, 80, 0)
sea_green = color.rgb(46, 139, 87, 0)
slate_gray = color.rgb(112, 128, 144, 0)
bright_orange = color.rgb(255, 165, 0, 0)
neon_green = color.rgb(57, 255, 20, 0)
electric_blue = color.rgb(125, 249, 255, 0)
magenta = color.rgb(255, 0, 255, 0)
lime = color.rgb(0, 255, 0, 0)
turquoise = color.rgb(64, 224, 208, 0)
fuchsia = color.rgb(255, 0, 255, 0)
sunset_orange = color.rgb(255, 97, 56, 0)
neon_purple = color.rgb(153, 50, 204, 0)
deep_pink = color.rgb(255, 20, 147, 0)
aqua = color.rgb(0, 255, 255, 0)
chartreuse = color.rgb(127, 255, 0, 0)
crimson = color.rgb(220, 20, 60, 0)
yellow_green = color.rgb(154, 205, 50, 0)
electric_yellow = color.rgb(255, 255, 0, 0)
radical_red = color.rgb(255, 51, 51, 0)
midnight_blue = color.rgb(25, 25, 112, 0)
dodger_blue = color.rgb(30, 144, 255, 0)
salmon = color.rgb(250, 128, 114, 0)
orange_red = color.rgb(255, 69, 0, 0)
peach_puff = color.rgb(255, 218, 185, 0)
steel_blue = color.rgb(70, 130, 180, 0)
indigo = color.rgb(75, 0, 130, 0)
light_coral = color.rgb(240, 128, 128, 0)
plum = color.rgb(221, 160, 221, 0)
forest_green = color.rgb(34, 139, 34, 0)
chocolate = color.rgb(210, 105, 30, 0)
pale_turquoise = color.rgb(175, 238, 238, 0)
papaya_whip = color.rgb(255, 239, 194, 0)
orangered = color.rgb(255, 69, 0, 0)
light_blue = color.rgb(173, 216, 230, 0)
peru = color.rgb(205, 133, 63, 0)
turquoise_blue = color.rgb(0, 199, 140, 0)
cadet_blue = color.rgb(95, 158, 160, 0)
snow = color.rgb(255, 250, 250, 0)
mint_cream = color.rgb(245, 255, 250, 0)
lavender = color.rgb(230, 230, 250, 0)
dark_orange = color.rgb(255, 140, 0, 0)
antique_white = color.rgb(250, 235, 215, 0)
light_salmon = color.rgb(255, 160, 122, 0)
sienna = color.rgb(160, 82, 45, 0)
fav1 =color.rgb(156, 38, 177)
fav2 =color.rgb(233, 30, 99)

// Calculate Heiken Ashi Candles
var float heikenAshiOpen = na
var float heikenAshiClose = na
var float heikenAshiHigh = na
var float heikenAshiLow = na



heikenAshiClose := (open + high + low + close) / 4
heikenAshiOpen := na(heikenAshiOpen[1]) ? (open + close) / 2 : (heikenAshiOpen[1] + heikenAshiClose[1]) / 2
heikenAshiHigh := math.max(high, math.max(heikenAshiOpen, heikenAshiClose))
heikenAshiLow := math.min(low, math.min(heikenAshiOpen, heikenAshiClose))


// Input settings
startTradeHour = input.int(9, title="Start Trading Hour", minval=0, maxval=23, group="BASIC")
endTradeHour = input.int(15, title="End Trading Hour", minval=0, maxval=23, group="BASIC")
endTradeMinute = input.int(15, title="End Trading Minute", minval=0, maxval=59, group="BASIC")
fixedStopLoss = input.float(0.50, title="Fixed Stop Loss (%)", minval=0.1, group="PROFIT/LOSS")
trailingStopLoss = input.float(0.50, title="Trailing Stop Loss (%)", minval=0.1, group="PROFIT/LOSS")
profitTarget = input.float(1.0, title="Profit Target (%)", minval=0.1, group="PROFIT/LOSS")
coolOffPeriod = input.int(20, title="Cool-Off Period (minutes)", minval=1, group="COOL TIME")


// VWAP Calculation based on hlc3
customHlc3 = (high + low + close) / 3
vwap = ta.vwap(customHlc3)


// Plot VWAP in yellow
plot(vwap, color=gold, title="VWAP", linewidth=2)


// Calculate EMAs
//ema5 = ta.ema(heikenAshiClose, 5)
//ema21 = ta.ema(heikenAshiClose, 21)

ema5 = ta.ema(close, 9)
ema21 = ta.ema(close, 21)
plot(ema5, color=fav1, title="EMA 9", linewidth=2)
plot(ema21, color=fav2 , title="EMA 21", linewidth=2)

// Calculate EMA with length 5
ema1 = ta.ema(close, 5)

// Plot the EMA on the chart
plot(ema1, title="EMA 5", color=turquoise_blue, linewidth=2)
// Plot EMAs with specified colors and line width



// Function to calculate Hull Moving Average (HMA)
//hma(src, length) =>
   // wma1 = ta.wma(src, length)
   // wma2 = ta.wma(src, length / 2)
   // hma_length = math.sqrt(length)
   // hma_length_int = math.round(hma_length)  // Convert to integer
   //// ta.wma(2 * wma2 - wma1, hma_length_int)


// Calculate HMAs
//hma10 = hma(close, 30)
//hma20 = hma(close, 60)


// Plot HMAs
//plot(hma10, color=color.blue, title="HMA 10", linewidth=2)
//plot(hma20, color=color.orange, title="HMA 20", linewidth=2)


// Trading time window
isTradingTime = (hour >= startTradeHour and hour <= endTradeHour) and (hour < endTradeHour or (hour == endTradeHour and minute <= endTradeMinute))


// Check if the bottom of the candle is flat and green
candleBottomFlat = low == open
candleGreen = close > open

// Tracking if a flat-bottom candle has been seen
var bool flatBottomSeen = false


// Update the flat-bottom tracking
if (candleBottomFlat)
    flatBottomSeen := true


// Track last trade time
var int lastTradeTime = na
if (strategy.opentrades > 0)
    lastTradeTime := time


// Calculate time since last trade in minutes
timeSinceLastTrade = na(lastTradeTime) ? na : (time - lastTradeTime) / 60000


// Cool-Off period logic
canTrade = na(lastTradeTime) or (timeSinceLastTrade >= coolOffPeriod)


// Calculate 2% above the first Heiken Ashi open price
var float firstHeikenAshiOpen = na
if (year != year[1] or dayofmonth != dayofmonth[1])  // Reset at the start of a new day
    firstHeikenAshiOpen := heikenAshiOpen


heikenAshiOpenThreshold = firstHeikenAshiOpen * 1.02


// New condition: Price must cross 2% above the first Heiken Ashi open
priceCrosses2Percent = heikenAshiClose > heikenAshiOpenThreshold


// Buy/Sell logic based on VWAP, EMA conditions, and whether a flat-bottom candle has been seen
buySignal = isTradingTime and priceCrosses2Percent and (ta.crossover(heikenAshiClose, vwap) or heikenAshiClose > vwap) and ema5 > ema21 and flatBottomSeen and candleGreen and canTrade
sellSignal = isTradingTime and ta.crossunder(heikenAshiClose, vwap)


// Execute trades based on signals
if (buySignal)
    strategy.entry("Buy", strategy.long)
    flatBottomSeen := false  // Reset after buying
    lastTradeTime := time  // Update last trade time


if (sellSignal)
    strategy.close("Buy")


// Exit conditions for all positions
if (strategy.opentrades > 0)
    // Calculate Fixed Stop Loss
    fixed_stop_price = strategy.position_avg_price * (1 - fixedStopLoss / 100)
   
    // Calculate Trailing Stop Loss: Offset will follow the price by 0.50%
    trail_offset = trailingStopLoss / 100 * strategy.position_avg_price
   
    // Calculate Profit Target
    profit_target = strategy.position_avg_price * (1 + profitTarget / 100)


    // Apply Exit Conditions
    strategy.exit("Fixed Stop Loss", from_entry="Buy", stop=fixed_stop_price)
    strategy.exit("Trailing Stop Loss", from_entry="Buy", trail_offset=trail_offset, trail_price=na)
    strategy.exit("Profit Target", from_entry="Buy", limit=profit_target)


    // New Exit Condition: If price crosses below the fast EMA (EMA 9)
    //if (ta.crossunder(close, ema9))
      //  strategy.close("Buy")


// Square off positions at or after the end of the session
if (hour > endTradeHour or (hour == endTradeHour and minute >= endTradeMinute))
    strategy.close_all()








// Volume Spike Detection
volumeAvgLength = input.int(20, title="Volume Moving Average Length", minval=1, group="VOLUME SPIKE")
volumeMultiplier = input.float(3.0, title="Volume Spike Multiplier", minval=0.1, group="VOLUME SPIKE")
volumeSpike = volume > ta.sma(volume, volumeAvgLength) * volumeMultiplier


plotshape(volumeSpike, style=shape.triangleup, location=location.belowbar, color=chartreuse, size=size.small, title="Volume Spike")




// Define the start and end times for monitoring
startTime = timestamp("GMT+5:30", year, month, dayofmonth, 9, 15)  // 9:15 AM
endTime = timestamp("GMT+5:30", year, month, dayofmonth, 11, 0)    // 11:00 AM


// Variables to store the session high and low, reset at the start of each day
var float sessionLow = na
var float sessionHigh = na


// Store the bar index at 9:15 AM
var int sessionStartIndex = na


if (hour == 9 and minute == 15)  // Reset session values at 9:15 AM
    sessionLow := na
    sessionHigh := na
    sessionStartIndex := bar_index  // Capture the starting bar index for drawing the lines


// Only calculate the session high and low between 9:15 AM and 11:00 AM
if (time >= startTime and time <= endTime)
    sessionLow := na(sessionLow) ? low : math.min(sessionLow, low)
    sessionHigh := na(sessionHigh) ? high : math.max(sessionHigh, high)


// Draw lines after 11:00 AM
// if (time > endTime and not na(sessionStartIndex))
//     // Draw a red line for the session low from 9:15 to 11:00 AM
//     line.new(sessionStartIndex, sessionLow, bar_index, sessionLow, color=color.red, width=2, extend=extend.right)
   
//     // Draw a green line for the session high from 9:15 to 11:00 AM
//     line.new(sessionStartIndex, sessionHigh, bar_index, sessionHigh, color=color.green, width=2, extend=extend.right)



// Function to calculate TMA
//tma(src, length) =>
 //   ta.sma(ta.sma(src, length), length)

// Calculate TMA for 5 and 10 periods
//tma5 = tma(close, 6)
//tma10 = tma(close, 12)

// Plot TMAs
//plot(tma5, color=color.blue, title="TMA 5", linewidth=2)
//plot(tma10, color=color.orange, title="TMA 10", linewidth=2)

// Detect Crossovers and Crossunders
bullishCross = ta.crossover(ema5,ema21)  // TMA 5 crosses above TMA 10
bearishCross = ta.crossunder(ema5, ema21) // TMA 5 crosses below TMA 10

// Plot buy and sell signals
plotshape(series=bullishCross, title="Buy Signal", location=location.belowbar, color=pale_turquoise, style=shape.labelup, text="BUY")
plotshape(series=bearishCross, title="Sell Signal", location=location.abovebar, color=plum, style=shape.labeldown, text="SELL")


// Input for WMA lengths
//fastWMA_length = input.int(5, title="Fast WMA Length", group="WMA")
//slowWMA_length = input.int(20, title="Slow WMA Length", group="WMA")

// Calculate the WMAs
//fastWMA = ta.wma(close, fastWMA_length)
//slowWMA = ta.wma(close, slowWMA_length)

// Plot the WMAs
//plot(fastWMA, color=color.new(color.blue, 0), linewidth=2, title="Fast WMA")
//plot(slowWMA, color=color.new(color.red, 0), linewidth=2, title="Slow WMA")




// Input parameters
length = input.int(100, title="Length", group="BOLLINGER")
mult = input.float(2, title="Standard Deviation Multiplier", group="BOLLINGER")
source = input.source(close, title="Source", group="BOLLINGER")

// Calculate Bollinger Bands
basis = ta.sma(source, length)
dev = mult * ta.stdev(source, length)
upper = basis + dev
lower = basis - dev

// Plot Bollinger Bands
plot(basis, color=chartreuse, linewidth=2, title="Median")
plot(upper, color=electric_blue, linewidth=1, title="Upper Band")

//plot(upper, color=color.new(color.blue, 50), linewidth=2, title="Upper Band")
plot(lower, color=electric_blue, linewidth=1, title="Lower Band")

// Fill between the upper and lower bands
//bgcolor(color=color.new(color.blue, 90), transp=90, title="Bands Fill")

// Calculate VWAP
vwap11 = ta.vwap

// Calculate Bollinger Bands
bb_length11 = 20
bb_stdDev11 = 2.5
bb_basis11 = ta.sma(close, bb_length11)
bb_dev11 = ta.stdev(close, bb_length11) * bb_stdDev11
bb_upper11 = bb_basis11 + bb_dev11
bb_lower11 = bb_basis11 - bb_dev11

// Check for VWAP crossing Bollinger Band median (bb_basis11)
crossing_up11 = ta.crossover(vwap11, bb_basis11)
crossing_down11 = ta.crossunder(vwap11, bb_basis11)



// Plot filled circles for crosses
plotshape(series=crossing_up11, title="VWAP Crosses Up", location=location.belowbar, style=shape.circle, color=color.green, size=size.small)
plotshape(series=crossing_down11, title="VWAP Crosses Down", location=location.belowbar, style=shape.circle, color=color.red, size=size.small)

// Inputs
hmaLength44 = input.int(30, "HMA Length 44", group="HULL")
projectionBars44 = input.int(5, "Projection Bars 44", group="HULL")  // How many bars to project

// Hull Moving Average Calculation
hma44 = ta.wma(2 * ta.wma(close, hmaLength44 / 2) - ta.wma(close, hmaLength44), math.round(math.sqrt(hmaLength44)))

// Calculate the slope
slope44 = (hma44 - hma44[1]) / 1

// Projected values
projectedHMA44 = array.new_float(projectionBars44, na)
for i44 = 0 to projectionBars44 - 1
    array.set(projectedHMA44, i44, hma44 + slope44 * (i44 + 1))

// Plot the HMA
//plot(hma44, color=color.new(color.blue, 0), title="HMA 44")

// Plot the imaginary line as a series of future points
var line projLine44 = na
for i44 = 1 to projectionBars44 - 1  // Start from 1 to avoid -1 indexing
    if na(projLine44) == false
        line.delete(projLine44)
    projLine44 := line.new(bar_index + i44 - 1, array.get(projectedHMA44, i44 - 1), bar_index + i44, array.get(projectedHMA44, i44), color=color.yellow)

////////////////////









/////////////////////////////

// Input parameters
atrPeriod = input.int(10, title="ATR Period")
multiplier = input.float(1.5, title="ATR Multiplier")

// Calculate ATR
atrValue = ta.atr(atrPeriod)

// Calculate Supertrend
upperBand = hlc3 - (multiplier * atrValue)
lowerBand = hlc3 + (multiplier * atrValue)

// Track the trend
var float superTrend = na
superTrend := na(superTrend[1]) ?  hlc3: (close > superTrend[1] ? math.max(upperBand, superTrend[1]) : math.min(lowerBand, superTrend[1]))

// Plot Supertrend
plot(superTrend, color=superTrend > close ? color.red : color.green, linewidth=2)


///////////////2.5% line
// Get the daily open price
daily_open_price = request.security(syminfo.tickerid, "D", open)

// Calculate 2.5% above the daily open price
line_level = daily_open_price * 1.025

// Initialize the line once
var line above_line = na

// Draw or update the line
if na(above_line)
    above_line := line.new(x1=bar_index, y1=line_level, x2=bar_index + 1, y2=line_level, extend=extend.right, color=color.navy, width=2)
else
    line.set_y1(above_line, line_level)
    line.set_y2(above_line, line_level)

////////trade lines 


// === Grouped Inputs ===
group_pl = "Profit Loss"

tradeDirection_VO_L_chanu32  = input.string("Buy", options=["Buy", "Sell"], title="Trade Type", group=group_pl)
entryPrice_VO_L_chanu32      = input.float(100.0, title="Entry Price", group=group_pl)
targetPercent_VO_L_chanu32   = input.float(1.5, title="Target %", group=group_pl)
stoplossPercent_VO_L_chanu32 = input.float(0.75, title="Stoploss %", group=group_pl)

// === Calculated Levels ===
targetPrice_VO_L_chanu32   = tradeDirection_VO_L_chanu32 == "Buy" ? entryPrice_VO_L_chanu32 * (1 + targetPercent_VO_L_chanu32 / 100) : entryPrice_VO_L_chanu32 * (1 - targetPercent_VO_L_chanu32 / 100)
stoplossPrice_VO_L_chanu32 = tradeDirection_VO_L_chanu32 == "Buy" ? entryPrice_VO_L_chanu32 * (1 - stoplossPercent_VO_L_chanu32 / 100) : entryPrice_VO_L_chanu32 * (1 + stoplossPercent_VO_L_chanu32 / 100)

// === Plot Clean Lines ===
line.new(x1=bar_index, y1=entryPrice_VO_L_chanu32, x2=bar_index + 1, y2=entryPrice_VO_L_chanu32, extend=extend.right, color=color.white, width=2)
line.new(x1=bar_index, y1=targetPrice_VO_L_chanu32, x2=bar_index + 1, y2=targetPrice_VO_L_chanu32, extend=extend.right, color=color.green, width=2)
line.new(x1=bar_index, y1=stoplossPrice_VO_L_chanu32, x2=bar_index + 1, y2=stoplossPrice_VO_L_chanu32, extend=extend.right, color=color.red, width=2)
